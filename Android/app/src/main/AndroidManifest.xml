<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.constant.everydayjapanese">

    <application
        android:name=".basic.EverydayJapaneseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EverydayJapanese"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        <activity
            android:name=".scene.main.SettingActivity"
            android:exported="true" >
        </activity>

        <receiver
            android:name=".widget.EverydayJapaneseAppWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/everyday_japanese_app_widget_info" />
        </receiver>

        <activity
            android:name=".scene.main.HiraganaKatakanaPracticeActivity"
            android:exported="false" />
        <activity
            android:name=".scene.main.HiraganaKatakanaActivity"
            android:exported="false" />
        <activity
            android:name=".scene.debug.SceneActivity"
            android:exported="false" />
        <activity
            android:name=".scene.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".scene.main.DayActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".scene.main.StudyActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".scene.main.TestActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".scene.main.TestResultActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>